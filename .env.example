# --- KeeperHub ---
# Create at app.keeperhub.com > Settings > API Keys > Organisation tab
KEEPERHUB_API_KEY=kh_xxxxxxxxxxxxxxxxxxxxxxxx
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp
KEEPERHUB_API_BASE=https://app.keeperhub.com/api
KEEPERHUB_ORG_ID=

# Start on Sepolia while building. Only switch to a mainnet chain id
# for the one real transaction the submission requires.
KEEPERHUB_CHAIN=sepolia

# --- Telegram ---
# Create via @BotFather
TELEGRAM_BOT_TOKEN=
# Your Telegram user ID (get it from @userinfobot). Comma-separate for
# more than one person. Required — the bot refuses all commands if empty.
TELEGRAM_ALLOWED_USER_IDS=

# --- x402 paid endpoint (the "other agents pay to trigger protection" surface) ---
# Price per provisioning call, in USDC, charged to whoever calls POST /protect
X402_PRICE_USDC=0.05
# Wallet address that receives x402 payments for this service
X402_PAY_TO_ADDRESS=
X402_PORT=4021
# Leave false until the real x402 payment middleware (see src/x402/server.js)
# is wired in. While false, the server only listens on localhost.
X402_PUBLIC=false

# --- General ---
PORT=3000
LOG_LEVEL=info
